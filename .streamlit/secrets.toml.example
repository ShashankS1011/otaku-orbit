# Copy these keys into Streamlit Community Cloud secrets or a local
# .streamlit/secrets.toml file. Register the redirect URI with your OIDC provider.
# Never commit real credentials.

[auth]
redirect_uri = "https://YOUR-APP-HOST/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "REPLACE_WITH_OIDC_CLIENT_ID"
client_secret = "REPLACE_WITH_OIDC_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
